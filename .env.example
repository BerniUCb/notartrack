# Conexión a PostgreSQL (Neon).
# Copiá este archivo a .env.local y reemplazá el valor con tu connection string real.
# En Neon: panel del proyecto → botón "Connect" → copiá la "Connection string".
# Usá la variante con "-pooler" en el host (recomendada para serverless / Vercel).
DATABASE_URL="postgresql://usuario:password@ep-xxxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para Auth.js (firma de sesiones). Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplazar-por-un-secreto-aleatorio"

# Twilio (sandbox de WhatsApp) para las notificaciones de la Fase 4.
# En la consola de Twilio: Account SID y Auth Token del proyecto.
# TWILIO_WHATSAPP_FROM es el número del sandbox (Messaging → Try it out → WhatsApp).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="tu-auth-token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
