# Conexión a PostgreSQL (Neon).
# Copiá este archivo a .env.local y reemplazá el valor con tu connection string real.
# En Neon: panel del proyecto → botón "Connect" → copiá la "Connection string".
# Usá la variante con "-pooler" en el host (recomendada para serverless / Vercel).
DATABASE_URL="postgresql://usuario:password@ep-xxxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para Auth.js (firma de sesiones). Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplazar-por-un-secreto-aleatorio"

# WhatsApp Cloud API de Meta para las notificaciones de la Fase 4.
# En developers.facebook.com → tu app → WhatsApp → API Setup:
#   WHATSAPP_PHONE_NUMBER_ID: el "Phone number ID" del número de prueba.
#   WHATSAPP_ACCESS_TOKEN: el token de acceso (el temporal dura 24 h; para algo
#     permanente, generá un token de System User con permiso
#     whatsapp_business_messaging).
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_ACCESS_TOKEN="EAAG...tu-token"
# Opcional: versión de la Graph API (por defecto v21.0).
# WHATSAPP_API_VERSION="v21.0"
